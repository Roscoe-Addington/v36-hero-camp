# Copy this file to .env and fill it in. Never commit .env (it holds passwords).

# The public address of the app. Used to build the patient links.
# Must start with https:// in real use.
BASE_URL=http://localhost:3000
PORT=3000

# Set to true if the app runs behind a reverse proxy (nginx, a hosting platform).
TRUST_PROXY=false

# How many days a patient link stays valid.
LINK_VALID_DAYS=14

# Where the SQLite database file is stored.
DB_PATH=data/app.db

# --- Email (SMTP) ---
# Leave SMTP_HOST empty while developing: emails are then written to outbox/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=screening@your-clinic.example

# The full personal number is masked (only the last 4 digits) in emails by
# default. Ordinary email is not a secure channel for identifiable health data.
EMAIL_INCLUDE_PERSONAL_NUMBER=false

# Crisis text shown to patients. Change it for your country / service.
# CRISIS_TEXT=If you are in danger or thinking about harming yourself, call 112 now.
